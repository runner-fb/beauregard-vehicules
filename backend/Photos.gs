function photo_(s,p){const r=p.amendment?record_(s,p.record,false):writeRecord_(s,{...p,id:p.record});if(p.amendment){admin_(s);if(r.archived)throw Error('DOSSIER_ARCHIVE');if(r.state!=='final')throw Error('Contrôle non clôturé')}else if(r.state!=='draft')throw Error('Contrôle verrouillé');assertId_(p.id);const old=get_('Photos',p.id);if(old){if(old.record!==r.id||old.deleted)throw Error('Photo non accessible');if(old.hash!==digest_(p.data))throw Error('Identifiant photo réutilisé pour un contenu différent');return old;}
 if(typeof p.data!=='string'||p.data.length>3500000||!/^data:image\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(p.data))throw Error('JPEG invalide ou trop volumineux');const bytes=Utilities.base64Decode(p.data.split(',')[1]);if((bytes[0]&255)!==255||(bytes[1]&255)!==216)throw Error('Contenu JPEG invalide');const folder=folder_(vehicleFolder_(r),'Photos');const name=p.id+'.jpg';const existing=folder.getFilesByName(name);const file=existing.hasNext()?existing.next():folder.createFile(Utilities.newBlob(bytes,'image/jpeg',name));if(digest_('data:image/jpeg;base64,'+Utilities.base64Encode(file.getBlob().getBytes()))!==digest_(p.data))throw Error('Le fichier distant porte cet identifiant avec un contenu différent');const ph={id:p.id,record:r.id,edition:r.edition,fileId:file.getId(),hash:digest_(p.data),at:time_(),by:s.name,amendment:!!p.amendment,deleted:false};put_('Photos',ph);audit_(s,'Photo enregistrée',r.id,{photo:p.id});return ph;}
function deletePhoto_(s,p){const ph=get_('Photos',p.id);if(!ph)return true;const r=writeRecord_(s,{...p,id:ph.record});if(r.state!=='draft')throw Error('Contrôle verrouillé');if(rows_('Records').some(x=>Model.photos(x.data).includes(p.id))||rows_('Amendments').some(x=>x.photos.includes(p.id)))throw Error('La photo est encore référencée');if(!ph.deleted){DriveApp.getFileById(ph.fileId).setTrashed(true);ph.deleted=true;put_('Photos',ph);audit_(s,'Photo retirée vers la corbeille',r.id,{photo:p.id});}return true;}
function readFile_(s,p){if(p.photo){const ph=get_('Photos',p.photo);if(!ph||ph.deleted)throw Error('Photo introuvable');try{record_(s,ph.record,false);}catch(e){if(!rows_('Records').some(r=>!r.deleted&&!r.archived&&r.edition===active_()&&r.initialId===ph.record&&r.owner===actorKey_(s)))throw e;}return {mime:'image/jpeg',base64:Utilities.base64Encode(DriveApp.getFileById(ph.fileId).getBlob().getBytes())};}const r=record_(s,p.record,false);let f=r.pdf;if(p.amendment){const a=get_('Amendments',p.amendment);if(!a||a.record!==r.id)throw Error('Avenant introuvable');f=a.pdf;}if(!f)throw Error('PDF pas encore généré');return {mime:'application/pdf',base64:Utilities.base64Encode(DriveApp.getFileById(f.id).getBlob().getBytes()),name:f.name};}

// Independent video records live in Operations; visual inspections remain immutable.
const VIDEO_CHUNK_=1048576;
function videoKey_(r,kind){if(!['pickup','return'].includes(kind))throw Error('Type de vidéo invalide');return 'video:'+r.id+':'+kind;}
function videoVehicle_(s,id,write){assertId_(id);let r=get_('Records',id);if(r?.kind==='return')r=get_('Records',r.initialId);if(!r||r.kind!=='pickup'||r.deleted)throw Error('Prise en charge introuvable');editionAccess_(s,r.edition,write);if(r.archived)admin_(s);return r;}
function videoPublic_(v){return v?{id:v.id,record:v.record,kind:v.kind,name:v.name,mime:v.mime,size:v.size,offset:v.offset||0,ready:v.ready===true,at:v.at}:null;}
function videoList_(s,p){const ed=p.edition||active_();editionAccess_(s,ed,false);const saved=rows_('Operations').filter(v=>v.id.startsWith('video:')&&v.ready);return rows_('Records').filter(r=>r.edition===ed&&r.kind==='pickup'&&!r.deleted&&!r.archived&&!saved.some(v=>v.record===r.id&&v.kind===p.kind)).map(r=>({id:r.id,edition:r.edition,vehicle:r.data.vehicle}));}
function videoFiles_(s,p){const source=record_(s,p.record,false);const id=source.kind==='return'?source.initialId:source.id;if(!id)return [];return ['pickup','return'].map(kind=>videoPublic_(get_('Operations','video:'+id+':'+kind))).filter(v=>v?.ready);}
function videoFetch_(url,options){return UrlFetchApp.fetch(url,{...options,headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken(),...(options?.headers||{})},muteHttpExceptions:true,followRedirects:false});}
function videoError_(response){throw Error('Transfert vidéo indisponible (Drive HTTP '+response.getResponseCode()+'). Réessaie : ta vidéo locale est conservée.');}
function videoMeta_(v){const res=videoFetch_('https://www.googleapis.com/drive/v3/files/'+encodeURIComponent(v.fileId)+'?fields=id,size,mimeType,trashed,parents,name',{});if(res.getResponseCode()===404)return null;if(res.getResponseCode()!==200)videoError_(res);return JSON.parse(res.getContentText());}
function videoConfirm_(v){const file=videoMeta_(v);if(!file||file.trashed||Number(file.size)!==v.size||file.mimeType!==v.mime||!file.parents?.includes(v.folderId)||file.name!==v.name)return false;v.ready=true;v.offset=v.size;v.at=time_();delete v.uploadUrl;put_('Operations',v);return true;}
function videoSession_(v){const res=videoFetch_('https://www.googleapis.com/upload/drive/v3/files?uploadType=resumable&fields=id,size,mimeType',{method:'post',contentType:'application/json',headers:{'X-Upload-Content-Type':v.mime,'X-Upload-Content-Length':String(v.size)},payload:JSON.stringify({id:v.fileId,name:v.name,mimeType:v.mime,parents:[v.folderId]})});if(res.getResponseCode()!==200)videoError_(res);const headers=res.getAllHeaders();v.uploadUrl=headers.Location||headers.location;if(!/^https:\/\/www\.googleapis\.com\//.test(v.uploadUrl||''))throw Error('Session Drive invalide');v.offset=0;put_('Operations',v);}
function videoStatusInternal_(v){if(v.ready)return videoPublic_(v);if(videoConfirm_(v))return videoPublic_(v);if(!v.uploadUrl){videoSession_(v);return videoPublic_(v);}const res=videoFetch_(v.uploadUrl,{method:'put',headers:{'Content-Range':'bytes */'+v.size},payload:''});const code=res.getResponseCode();if(code===200||code===201){if(!videoConfirm_(v))throw Error('Confirmation vidéo incomplète');}else if(code===308){const h=res.getAllHeaders(),range=String(h.Range||h.range||''),m=range.match(/bytes=0-(\d+)/);v.offset=m?Number(m[1])+1:0;put_('Operations',v);}else if(code===404||code===410){delete v.uploadUrl;videoSession_(v);}else videoError_(res);return videoPublic_(v);}
function videoStart_(s,p){const r=videoVehicle_(s,p.record,true),id=videoKey_(r,p.kind);assertId_(p.uploadId);const mime=String(p.mime||'').split(';')[0].toLowerCase(),ext={'video/mp4':'mp4','video/webm':'webm','video/quicktime':'mov','video/3gpp':'3gp'}[mime];if(!ext||!Number.isSafeInteger(p.size)||p.size<=0)throw Error('Format ou taille vidéo invalide');let v=get_('Operations',id);if(v){if(v.ready){if(v.uploadId!==p.uploadId)throw Error('Une vidéo de ce type est déjà enregistrée pour ce véhicule.');return videoPublic_(v);}videoStatusInternal_(v);if(v.ready){if(v.uploadId!==p.uploadId)throw Error('Une vidéo de ce type est déjà enregistrée pour ce véhicule.');return videoPublic_(v);}if(v.uploadId!==p.uploadId||v.owner!==actorKey_(s))throw Error('Une vidéo de ce type est déjà en cours de transfert. Reprends-la sur l’appareil utilisé.');if(v.size!==p.size||v.mime!==mime)throw Error('La vidéo locale ne correspond pas au transfert');return videoPublic_(v);}
 const res=videoFetch_('https://www.googleapis.com/drive/v3/files/generateIds?count=1&space=drive&type=files',{});if(res.getResponseCode()!==200)videoError_(res);const fileId=JSON.parse(res.getContentText()).ids[0];v={id,record:r.id,edition:r.edition,kind:p.kind,uploadId:p.uploadId,owner:actorKey_(s),fileId,folderId:vehicleFolder_(r).getId(),mime,size:p.size,offset:0,ready:false,createdAt:time_(),name:Model.plate(r.data.vehicle.plate)+'_'+(p.kind==='pickup'?'PRISE_EN_CHARGE':'RESTITUTION')+'_'+Utilities.formatDate(new Date(),'Europe/Paris','yyyy-MM-dd_HHmm')+'.'+ext};put_('Operations',v);videoSession_(v);return videoPublic_(v);}
function videoUpload_(s,p){const r=videoVehicle_(s,p.record,true),v=get_('Operations',videoKey_(r,p.kind));if(!v)throw Error('Transfert vidéo introuvable');if(v.ready)return videoPublic_(v);if(v.uploadId!==p.uploadId||v.owner!==actorKey_(s))throw Error('Accès au transfert refusé');if(p.action==='videoStatus')return videoStatusInternal_(v);if(!Number.isSafeInteger(p.offset)||p.offset<0||typeof p.data!=='string'||p.data.length>1400000||!/^[A-Za-z0-9+/]+={0,2}$/.test(p.data))throw Error('Bloc vidéo invalide');const state=videoStatusInternal_(v);if(state.ready||p.offset!==v.offset)return state;const bytes=Utilities.base64Decode(p.data),end=p.offset+bytes.length;if(!bytes.length||bytes.length>VIDEO_CHUNK_||end>v.size||(end<v.size&&bytes.length%262144!==0))throw Error('Taille du bloc vidéo invalide');const hash=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,bytes).map(b=>('0'+((b+256)%256).toString(16)).slice(-2)).join('');if(hash!==p.hash)throw Error('Bloc vidéo altéré : recommence le transfert');const res=videoFetch_(v.uploadUrl,{method:'put',contentType:v.mime,headers:{'Content-Range':'bytes '+p.offset+'-'+(end-1)+'/'+v.size},payload:bytes});if(![200,201,308].includes(res.getResponseCode()))videoError_(res);return videoStatusInternal_(v);}
function videoRead_(s,p){const available=videoFiles_(s,{record:p.record}),info=available.find(v=>v.kind===p.kind);if(!info)throw Error('Vidéo introuvable');const v=get_('Operations',info.id);const offset=Number(p.offset);if(!Number.isSafeInteger(offset)||offset<0||offset>=v.size)throw Error('Position vidéo invalide');const end=Math.min(offset+VIDEO_CHUNK_,v.size)-1;const res=videoFetch_('https://www.googleapis.com/drive/v3/files/'+encodeURIComponent(v.fileId)+'?alt=media',{headers:{Range:'bytes='+offset+'-'+end}});if(res.getResponseCode()!==206&&!(offset===0&&v.size<=VIDEO_CHUNK_&&res.getResponseCode()===200))videoError_(res);const bytes=res.getBlob().getBytes();if(bytes.length!==end-offset+1)throw Error('Lecture vidéo incomplète');return {data:Utilities.base64Encode(bytes),offset:end+1,size:v.size,mime:v.mime,name:v.name};}
