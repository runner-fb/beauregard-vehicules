function imageInto_(body,blob,maxW,maxH){const im=body.appendImage(blob);const f=Math.min(maxW/im.getWidth(),maxH/im.getHeight(),1);im.setWidth(Math.round(im.getWidth()*f)).setHeight(Math.round(im.getHeight()*f));return im}
function photoInto_(body,id,label){const p=get_('Photos',id);if(!p||p.deleted)throw Error('Photo manquante pendant la génération');body.appendParagraph(label);imageInto_(body,DriveApp.getFileById(p.fileId).getBlob(),480,300);}
function annotated_(r,view){const type={'Voiture':'voiture','9 places':'minibus','Utilitaire':'utilitaire'}[r.data.vehicle.type];const it=DriveApp.getFolderById(props_().getProperty('ASSETS_FOLDER_ID')).getFilesByName(type+'-'+view+'.png');if(!it.hasNext())throw Error('Illustration système absente : '+type+'-'+view+'.png');const pres=SlidesApp.create('TEMP — annotation '+r.id+' '+view);const pid=pres.getId();try{const slide=pres.getSlides()[0];slide.getPageElements().forEach(e=>e.remove());const w=pres.getPageWidth(),h=pres.getPageHeight(),iw=Math.min(w,h*1000/600),ih=iw*600/1000,x0=(w-iw)/2,y0=(h-ih)/2;slide.insertImage(it.next().getBlob(),x0,y0,iw,ih);for(const d of Object.values(r.data.damages).filter(d=>d.view===view)){const cx=x0+d.x*iw,cy=y0+d.y*ih,radius=7,color=d.initial?'#111111':'#d32f2f';for(const direction of [-1,1]){const cross=slide.insertLine(SlidesApp.LineCategory.STRAIGHT,cx-radius,cy-direction*radius,cx+radius,cy+direction*radius);cross.setWeight(2.5);cross.getLineFill().setSolidFill(color);}}const sid=slide.getObjectId();pres.saveAndClose();const url='https://slides.googleapis.com/v1/presentations/'+pid+'/pages/'+sid+'/thumbnail?thumbnailProperties.thumbnailSize=LARGE';const resp=UrlFetchApp.fetch(url,{headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()},muteHttpExceptions:true});if(resp.getResponseCode()!==200){let error={};try{error=JSON.parse(resp.getContentText()).error||{}}catch(_){}const disabled=JSON.stringify(error).includes('SERVICE_DISABLED')||JSON.stringify(error).includes('accessNotConfigured');throw Error(disabled?'Google Slides API est désactivée dans le projet Cloud associé. Demande son activation à l’administrateur.':'La miniature PDF est indisponible (Slides HTTP '+resp.getResponseCode()+'). Vérifie les autorisations et quotas du projet.');}const info=JSON.parse(resp.getContentText());if(!info.contentUrl)throw Error('Miniature Slides absente');const image=UrlFetchApp.fetch(info.contentUrl,{muteHttpExceptions:true});if(image.getResponseCode()!==200)throw Error('Téléchargement de la vue PDF impossible (HTTP '+image.getResponseCode()+')');return image.getBlob();}finally{DriveApp.getFileById(pid).setTrashed(true)}}
function pdfFor_(s,id,isAmendment){const a=isAmendment?get_('Amendments',id):null;if(isAmendment&&!a)throw Error('Avenant introuvable');const r=record_(s,a?a.record:id,false);if(r.state!=='final')throw Error('Clôture nécessaire');const source=a||r;if(source.pdf)return source.pdf;for(const key of ['DATA_FOLDER_ID','ASSETS_FOLDER_ID'])if(!props_().getProperty(key))throw Error('Configuration PDF manquante : '+key);
 const d=DocumentApp.create('TEMP PDF '+id),did=d.getId();try{const body=d.getBody();body.setPageWidth(595.28).setPageHeight(841.89).setMarginTop(36).setMarginBottom(36).setMarginLeft(42).setMarginRight(42);body.editAsText().setFontFamily('Arial').setFontSize(10);const title=t=>body.appendParagraph(t).setHeading(DocumentApp.ParagraphHeading.HEADING1);const text=t=>body.appendParagraph(String(t));title('BEAUREGARD — VÉHICULES '+r.edition);text((a?'AVENANT ADMINISTRATEUR n°'+a.number:r.kind==='pickup'?'PRISE EN CHARGE':'RETOUR')+' • '+r.data.vehicle.plate);text(r.data.vehicle.brand+' '+r.data.vehicle.model+' • '+r.data.vehicle.color+' • '+r.data.vehicle.type);text('Dossier '+r.id);text('Création : '+r.createdAt+' par '+r.createdBy);text('Dernière intervention : '+r.updatedAt+' par '+r.updatedBy);text('Clôture : '+r.finalAt+' par '+r.finalBy);
 if(a){text('Avenant du '+a.at+' par '+a.by);title('Motif');text(a.reason);for(const c of a.changes){title(c.path.join(' / '));text('Ancienne valeur : '+JSON.stringify(c.old));text('Nouvelle valeur : '+c.value);}for(const ph of a.photos)photoInto_(body,ph,'Justificatif');text('Cet avenant ne modifie pas le document initial.');}
 else {if(r.kind==='return'&&!r.initialId)text('État des lieux de retour réalisé sans état des lieux initial disponible');const contested=Object.values(r.data.damages).filter(x=>x.contest);title('Récapitulatif');text('Repères : croix noires pour les dommages initiaux, rouges pour les dommages du présent contrôle. Les numéros sont conservés dans les listes de détails.');text('Kilométrage : '+r.data.mileage+' km — Carburant : '+r.data.fuel);if(r.initialValues){text('Départ : '+r.initialValues.mileage+' km — '+r.initialValues.fuel);text(r.data.mileage>=r.initialValues.mileage?'Distance parcourue : '+(r.data.mileage-r.initialValues.mileage)+' km':'Kilométrage incohérent : retour inférieur au départ. Distance non calculée.');}text(contested.length?contested.map(x=>'CONTESTATION n°'+x.number+' — '+x.contest.party+' : '+x.contest.reason).join('\n'):'Aucun dommage contesté');if(r.data.generalPhoto)photoInto_(body,r.data.generalPhoto,'Photographie générale');photoInto_(body,r.data.meterPhoto,'Compteur');photoInto_(body,r.data.fuelPhoto,'Jauge');
 for(const view of Model.views){body.appendPageBreak();title(view==='interieur'?'Intérieur':'Vue '+view);imageInto_(body,annotated_(r,view),500,340);const damages=Object.values(r.data.damages).filter(x=>x.view===view);if(!damages.length)text(view==='interieur'?'Aucun dommage intérieur constaté':'Aucun dommage constaté');else for(const x of damages)text('n°'+x.number+' — '+x.type+' — position '+(x.x*100).toFixed(1)+' % / '+(x.y*100).toFixed(1)+' %');}
 for(const x of Object.values(r.data.damages)){body.appendPageBreak();title('Dommage n°'+x.number+' — '+x.type);text('Vue : '+x.view+' — '+(x.evolution||x.classification||'Constaté au départ'));if(x.classification==='Présence antérieure déclarée')text('Cette mention constitue une déclaration, pas une preuve d’antériorité. L’état initial reste inchangé.');if(x.comment)text(x.comment);if(x.contest)text('DOMMAGE CONTESTÉ — '+x.contest.party+'\nMotif : '+x.contest.reason+'\n'+x.contest.at+' — '+x.contest.by);if(x.initial){text('Constat initial : '+x.initial.type+' — '+x.initial.comment);for(const ph of x.initial.photos)photoInto_(body,ph,'Photographie initiale');}for(const ph of x.photos)photoInto_(body,ph,'Photographie du présent contrôle');}
 body.appendPageBreak();title('Remarques complémentaires');text(r.data.remarks||'Aucune');title('Signatures');if(contested.length)text('La signature ne résout pas automatiquement les contestations ci-dessus.');for(const party of ['loueur','locataire']){const sig=r.signatures[party];text(party.toUpperCase()+' — '+(sig.name||'Identité non renseignée')+' — '+sig.at+' — recueilli par '+sig.by);if(sig.image)imageInto_(body,Utilities.newBlob(Utilities.base64Decode(sig.image.split(',')[1]),'image/png','signature.png'),300,120);else text('Pas de signature — '+sig.reason+(sig.note?' — '+sig.note:'')+'. Cette absence ne vaut pas accord.');}text('Données verrouillées le '+r.lockedAt+'. Document définitif. Toute correction fait l’objet d’un avenant distinct.');}
 d.saveAndClose();const blob=DriveApp.getFileById(did).getAs(MimeType.PDF);const name=pdfName_(r,a);return lock_(()=>{const fresh=get_(a?'Amendments':'Records',id);if(fresh.pdf)return fresh.pdf;const folder=vehicleFolder_(r);const found=folder.getFilesByName(name);const file=found.hasNext()?found.next():folder.createFile(blob.setName(name));fresh.pdf={id:file.getId(),name,at:time_(),sha256:digest_(Utilities.base64Encode(file.getBlob().getBytes()))};put_(a?'Amendments':'Records',fresh);audit_(s,'PDF définitif créé',r.id,{file:fresh.pdf.id,amendment:a?.id||null});return fresh.pdf;});
 }finally{DriveApp.getFileById(did).setTrashed(true)}}

function pdfName_(r,a){return a?'Avenant_'+(r.kind==='pickup'?'Prise_en_charge':'Retour')+'_'+String(a.number).padStart(3,'0')+'_'+a.id+'.pdf':r.kind==='pickup'?'Prise_en_charge.pdf':'Retour.pdf';}
