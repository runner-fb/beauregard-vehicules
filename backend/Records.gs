function dataShape_(d){if(!d||!d.vehicle||!d.views||!d.damages||Array.isArray(d.damages))throw Error('Données invalides');if(JSON.stringify(d).length>350000)throw Error('Dossier trop volumineux');for(const k of ['brand','model','color'])if(typeof d.vehicle[k]!=='string'||d.vehicle[k].length>100)throw Error('Identification invalide');if(!Model.types.includes(d.vehicle.type))throw Error('Type invalide');d.vehicle.plate=Model.plate(d.vehicle.plate);if(d.vehicle.plate.length<4||d.vehicle.plate.length>16)throw Error('Immatriculation invalide');if(typeof d.remarks!=='string'||d.remarks.length>10000)throw Error('Remarques trop longues');for(const [id,x] of Object.entries(d.damages)){assertId_(id);if(id!==x.id||!Array.isArray(x.photos)||x.photos.length>30)throw Error('Dommage invalide');if(!Model.views.includes(x.view)||!Number.isFinite(x.x)||!Number.isFinite(x.y)||x.x<0||x.x>1||x.y<0||x.y>1)throw Error('Position invalide');for(const k of ['comment','type','classification','evolution'])if(x[k]!==undefined&&(typeof x[k]!=='string'||x[k].length>5000))throw Error('Dommage invalide');}return d}
function peers_(r){return rows_('Records').filter(x=>x.edition===r.edition&&x.data.vehicle.plate===r.data.vehicle.plate&&x.kind===r.kind&&x.id!==r.id)}
function create_(s,p){assertId_(p.id);const old=get_('Records',p.id);if(old){editionAccess_(s,old.edition,true);return old;}if(!['pickup','return'].includes(p.kind))throw Error('Type de contrôle invalide');const data=dataShape_(p.data);const edition=active_();if(p.edition!==edition)throw Error('Édition locale différente de l’édition active');const r={id:p.id,edition,kind:p.kind,data,revision:1,state:'draft',createdAt:time_(),updatedAt:time_(),createdBy:s.name,updatedBy:s.name,signatures:{},operations:[],usedNumbers:{},initialId:null,pdf:null};
 const peers=peers_(r);if(peers.some(x=>x.state!=='draft'))throw Error('Un contrôle signé ou final existe déjà pour ce véhicule et ce type');if(peers.length&&!p.parallel)return {duplicate:true,records:peers.map(x=>({id:x.id,controller:x.updatedBy,updatedAt:x.updatedAt,plate:x.data.vehicle.plate,progress:Model.progress(x.data,x.kind)}))};
 if(r.kind==='return'){const initial=rows_('Records').find(x=>x.edition===edition&&x.data.vehicle.plate===data.vehicle.plate&&x.kind==='pickup'&&x.state==='final');if(initial){r.initialId=initial.id;r.data=Model.newData('return',initial.data.vehicle,initial.data);r.initialValues={mileage:initial.data.mileage,fuel:initial.data.fuel};}else if(!p.withoutInitial)throw Error('Confirme le retour sans état des lieux initial');}
 put_('Records',r);audit_(s,'Création',r.id,{parallel:!!p.parallel,withoutInitial:r.kind==='return'&&!r.initialId});return r;}
function save_(s,p){const r=record_(s,p.id,true);if(r.state!=='draft')throw Error('Contrôle verrouillé');if(r.revision!==p.revision)return {conflict:true,record:r};const d=dataShape_(p.data);if(d.vehicle.plate!==r.data.vehicle.plate)throw Error('L’immatriculation du dossier ne peut plus changer');
 const source=r.initialId?get_('Records',r.initialId):null;const initial=source?.data.damages||{};
 for(const [id,x] of Object.entries(initial)){const n=d.damages[id];if(!n||!Model.same(n.initial,x)||n.number!==x.number||n.view!==x.view||n.x!==x.x||n.y!==x.y||n.type!==x.type)throw Error('Dommage initial immuable');}
 for(const x of Object.values(d.damages)){const previous=r.data.damages[x.id];if(previous&&previous.number!==x.number)throw Error('Numéro de dommage immuable');const owner=(r.usedNumbers||{})[x.number];if(owner&&owner!==x.id)throw Error('Numéro de dommage déjà utilisé');if(x.initial&&!initial[x.id])throw Error('Référence initiale invalide');if(x.contest){if(!['Loueur','Locataire','Les deux'].includes(x.contest.party)||!x.contest.reason?.trim())throw Error('Contestation incomplète');const before=r.data.damages[x.id]?.contest;if(!before||before.reason!==x.contest.reason||before.party!==x.contest.party)x.contest={party:x.contest.party,reason:String(x.contest.reason).slice(0,5000),at:time_(),by:s.name};else x.contest=before;}}
 for(const id of Model.photos(d)){const ph=get_('Photos',id);if(ph&&ph.record!==r.id&&ph.record!==r.initialId)throw Error('Photo extérieure au dossier');}
 const changed=[];for(const k of Object.keys(d))if(!Model.same(d[k],r.data[k]))changed.push({field:k,old:r.data[k],value:d[k]});r.usedNumbers=r.usedNumbers||{};for(const x of Object.values(d.damages)){if(r.usedNumbers[x.number]&&r.usedNumbers[x.number]!==x.id)throw Error('Numéro de dommage dupliqué');r.usedNumbers[x.number]=x.id;}r.data=d;r.revision++;r.updatedAt=time_();r.updatedBy=s.name;put_('Records',r);audit_(s,'Modification',r.id,changed);return r;}
function ready_(s,p){const r=record_(s,p.id,true);if(p.revision!==r.revision)throw Error('Le dossier a changé. Synchronise puis consulte à nouveau le récapitulatif.');const errors=Model.validate(r.data,r.kind);if(errors.length)throw Error(errors[0].message);for(const id of Model.photos(r.data)){const ph=get_('Photos',id);if(!ph||ph.deleted||!ph.fileId||![r.id,r.initialId].includes(ph.record))throw Error('Photo non synchronisée : '+id);}if(peers_(r).some(x=>x.state!=='draft'))throw Error('Un autre contrôle est déjà signé ou clôturé. Contacte l’administrateur.');return r}
function sign_(s,p){let r=record_(s,p.id,true);if(r.signatures?.[p.party]?.op===p.op)return r;r=ready_(s,p);if(!['loueur','locataire'].includes(p.party))throw Error('Partie invalide');if(r.state==='final')throw Error('Contrôle clôturé');if(r.signatures[p.party]){if(r.signatures[p.party].op===p.op)return r;throw Error('Cette décision de signature est déjà enregistrée')}
 let signature;if(p.image){if(!/^data:image\/png;base64,[A-Za-z0-9+/=]+$/.test(p.image)||p.image.length>200000)throw Error('Signature PNG invalide');signature={image:p.image};r.state='locked';r.lockedAt=r.lockedAt||time_();}else{if(!['Non précisé','Refus de signer','Personne absente','Autre'].includes(p.reason))throw Error('Motif d’absence de signature invalide');signature={reason:p.reason,note:String(p.note||'').slice(0,3000)};}
 r.signatures[p.party]={...signature,at:time_(),by:s.name,op:assertId_(p.op)};r.revision++;r.updatedAt=time_();r.updatedBy=s.name;put_('Records',r);audit_(s,p.image?'Signature '+p.party:'Absence de signature '+p.party,r.id,{reason:p.reason||null});return r;}
function finalize_(s,p){let r=record_(s,p.id,true);if(r.state==='final')return r;r=ready_(s,p);if(!r.signatures.loueur||!r.signatures.locataire)throw Error('Choisis signer ou pas de signature pour chaque partie');r.state='final';r.finalAt=time_();r.finalBy=s.name;r.lockedAt=r.lockedAt||r.finalAt;r.revision++;r.updatedAt=r.finalAt;put_('Records',r);audit_(s,'Clôture',r.id,{revision:r.revision});return r;}
function amendment_(s,p){admin_(s);const r=record_(s,p.record,false);if(r.state!=='final')throw Error('Un avenant concerne un contrôle clôturé');assertId_(p.id);const old=get_('Amendments',p.id);if(old)return old;if(!String(p.reason||'').trim()||!Array.isArray(p.changes)||!p.changes.length)throw Error('Motif et modifications obligatoires');for(const c of p.changes){if(!Array.isArray(c.path)||!c.path.length||c.path.some(k=>['__proto__','prototype','constructor'].includes(k)))throw Error('Champ invalide');let actual=r.data;for(const k of c.path)actual=actual?.[k];if(!Model.same(actual,c.old))throw Error('Ancienne valeur incorrecte');if(typeof c.value!=='string'||c.value.length>10000)throw Error('Nouvelle valeur invalide');}
 const evidence=p.photos||[];for(const id of evidence){const ph=get_('Photos',id);if(!ph||ph.record!==r.id||!ph.amendment||ph.deleted)throw Error('Justificatif invalide');}
 const a={id:p.id,record:r.id,number:rows_('Amendments').filter(x=>x.record===r.id).length+1,at:time_(),by:s.name,reason:String(p.reason).slice(0,5000),changes:p.changes,photos:evidence,pdf:null};put_('Amendments',a);audit_(s,'Avenant administrateur',r.id,{amendment:a.id,reason:a.reason});return a;}
