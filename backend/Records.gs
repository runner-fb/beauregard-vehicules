function dataShape_(d,historicalPlate=null){if(!d||!d.vehicle||!d.views||!d.damages||Array.isArray(d.damages))throw Error('Données invalides');if(JSON.stringify(d).length>350000)throw Error('Dossier trop volumineux');for(const k of ['brand','model','color'])if(typeof d.vehicle[k]!=='string'||d.vehicle[k].length>100)throw Error('Identification invalide');if(!Model.types.includes(d.vehicle.type))throw Error('Type invalide');d.vehicle.plate=Model.plate(d.vehicle.plate);if(!/^[A-Z]{2}[0-9]{3}[A-Z]{2}$/.test(d.vehicle.plate)&&d.vehicle.plate!==historicalPlate)throw Error('Immatriculation attendue : AA123BB');if(typeof d.remarks!=='string'||d.remarks.length>10000)throw Error('Remarques trop longues');for(const [id,x] of Object.entries(d.damages)){assertId_(id);if(id!==x.id||!Array.isArray(x.photos)||x.photos.length>30)throw Error('Dommage invalide');if(!Model.views.includes(x.view)||!Number.isFinite(x.x)||!Number.isFinite(x.y)||x.x<0||x.x>1||x.y<0||x.y>1)throw Error('Position invalide');for(const k of ['comment','type','classification','evolution'])if(x[k]!==undefined&&(typeof x[k]!=='string'||x[k].length>5000))throw Error('Dommage invalide');}return d}
function peers_(r){return rows_('Records').filter(x=>!x.deleted&&!x.archived&&x.edition===r.edition&&x.data.vehicle.plate===r.data.vehicle.plate&&x.kind===r.kind&&x.id!==r.id)}
function create_(s,p){assertId_(p.id);if(get_('Operations','deleted:'+p.id))throw Error('DOSSIER_SUPPRIME');const old=get_('Records',p.id);if(old){if(old.deleted)throw Error('DOSSIER_SUPPRIME');record_(s,old.id,true);if(old.owner!==actorKey_(s))throw Error('AUTORISATION_REMPLACEE');if(old.kind==='return'&&p.creationOp&&old.creationOp!==p.creationOp)return {duplicate:true,records:[{id:old.id,controller:old.updatedBy,updatedAt:old.updatedAt,plate:old.data.vehicle.plate,progress:Model.progress(old.data,old.kind,old)}]};return old;}if(!['pickup','return'].includes(p.kind))throw Error('Type de contrôle invalide');const initial=p.kind==='return'?(p.initialId?get_('Records',p.initialId):rows_('Records').find(x=>!x.deleted&&!x.archived&&x.edition===active_()&&x.data.vehicle.plate===Model.plate(p.data?.vehicle?.plate)&&x.kind==='pickup'&&x.state==='final')):null;if(p.initialId&&!initial)throw Error('Prise en charge initiale introuvable');if(initial&&(initial.deleted||initial.archived||initial.kind!=='pickup'||initial.state!=='final'||initial.edition!==active_()||initial.data.vehicle.plate!==Model.plate(p.data?.vehicle?.plate)))throw Error('Prise en charge initiale invalide');const data=dataShape_(p.data,initial&&!initial.plateStrict?initial.data.vehicle.plate:null);const edition=active_();if(p.edition!==edition)throw Error('Édition locale différente de l’édition active');const r={id:p.id,creationOp:p.creationOp?assertId_(p.creationOp):p.id,edition,kind:p.kind,data,revision:1,state:'draft',createdAt:time_(),updatedAt:time_(),createdBy:s.name,updatedBy:s.name,owner:actorKey_(s),lease:id_(),lastActivityAt:time_(),signatures:{},operations:[],usedNumbers:{},initialId:null,pdf:null,plateStrict:initial?!!initial.plateStrict:true};
 assertVehicleAvailable_(s,{plate:r.data.vehicle.plate,kind:r.kind,edition,initialId:initial?.id});
 if(r.kind==='return'){if(initial){r.initialId=initial.id;r.data=Model.newData('return',initial.data.vehicle,initial.data);r.initialValues={mileage:initial.data.mileage,fuel:initial.data.fuel};}else if(!p.withoutInitial)throw Error('Confirme le retour sans état des lieux initial');}
 put_('Records',r);audit_(s,'Création',r.id,{withoutInitial:r.kind==='return'&&!r.initialId});return r;}
function save_(s,p){const r=writeRecord_(s,p);if(r.deleted)throw Error('Dossier supprimé');if(r.state!=='draft')throw Error('Contrôle verrouillé');if(r.revision!==p.revision)return {conflict:true,record:r};const d=dataShape_(p.data,r.plateStrict?null:r.data.vehicle.plate);if(d.vehicle.plate!==r.data.vehicle.plate)throw Error('L’immatriculation du dossier ne peut plus changer');
 const source=r.initialId?get_('Records',r.initialId):null;const initial=source?.data.damages||{};if(source&&!Model.same(d.vehicle,source.data.vehicle))throw Error('Identification du retour en lecture seule');
 for(const [id,x] of Object.entries(initial)){const n=d.damages[id];if(!n||!Model.same(n.initial,x)||n.number!==x.number||n.view!==x.view||n.x!==x.x||n.y!==x.y||n.type!==x.type)throw Error('Dommage initial immuable');}
 for(const x of Object.values(d.damages)){const previous=r.data.damages[x.id];if(previous&&previous.number!==x.number)throw Error('Numéro de dommage immuable');const owner=(r.usedNumbers||{})[x.number];if(owner&&owner!==x.id)throw Error('Numéro de dommage déjà utilisé');if(x.initial&&!initial[x.id])throw Error('Référence initiale invalide');if(x.contest){if(!Model.contestRelevant(x,r.kind)&&!Model.same(x.contest,r.data.damages[x.id]?.contest))throw Error('Contestation réservée à un écart constaté au retour');if(!['Loueur','Locataire','Les deux'].includes(x.contest.party)||!x.contest.reason?.trim())throw Error('Contestation incomplète');const before=r.data.damages[x.id]?.contest;if(!before||before.reason!==x.contest.reason||before.party!==x.contest.party)x.contest={party:x.contest.party,reason:String(x.contest.reason).slice(0,5000),at:time_(),by:s.name};else x.contest=before;}}
 for(const id of Model.photos(d)){const ph=get_('Photos',id);if(ph&&ph.record!==r.id&&ph.record!==r.initialId)throw Error('Photo extérieure au dossier');}
 const changed=[];for(const k of Object.keys(d))if(!Model.same(d[k],r.data[k]))changed.push({field:k,old:r.data[k],value:d[k]});r.usedNumbers=r.usedNumbers||{};for(const x of Object.values(d.damages)){if(r.usedNumbers[x.number]&&r.usedNumbers[x.number]!==x.id)throw Error('Numéro de dommage dupliqué');r.usedNumbers[x.number]=x.id;}r.data=d;if(changed.length)r.lastActivityAt=time_();r.revision++;r.updatedAt=time_();r.updatedBy=s.name;put_('Records',r);audit_(s,'Modification',r.id,changed);return r;}
function ready_(s,p){const r=writeRecord_(s,p);if(p.revision!==r.revision)throw Error('Le dossier a changé. Synchronise puis consulte à nouveau le récapitulatif.');if(r.deleted)throw Error('Dossier supprimé');const errors=Model.validate(r.data,r.kind,r.plateStrict?null:r.data.vehicle.plate);if(errors.length)throw Error(errors[0].message);for(const id of Model.photos(r.data)){const ph=get_('Photos',id);if(!ph||ph.deleted||!ph.fileId||![r.id,r.initialId].includes(ph.record))throw Error('Photo non synchronisée : '+id);}if(peers_(r).some(x=>x.state!=='draft'))throw Error('Un autre contrôle est déjà signé ou clôturé. Contacte l’administrateur.');return r}
function sign_(s,p){let r=writeRecord_(s,p);if(r.signatures?.[p.party]?.op===p.op)return r;r=ready_(s,p);if(!['loueur','locataire'].includes(p.party))throw Error('Partie invalide');if(r.state==='final')throw Error('Contrôle clôturé');if(r.signatures[p.party]){if(r.signatures[p.party].op===p.op)return r;throw Error('Cette décision de signature est déjà enregistrée')}
 let signature;if(p.image){if(!/^data:image\/png;base64,[A-Za-z0-9+/=]+$/.test(p.image)||p.image.length>200000)throw Error('Signature PNG invalide');const first=String(p.first||'').trim(),last=String(p.last||'').trim();if(!first||!last||first.length>60||last.length>60)throw Error('Prénom et nom du signataire obligatoires');signature={image:p.image,first,last,name:first+' '+last};r.state='locked';r.lockedAt=r.lockedAt||time_();}else{if(!['Non précisé','Refus de signer','Personne absente','Autre'].includes(p.reason))throw Error('Motif d’absence de signature invalide');signature={reason:p.reason,note:String(p.note||'').slice(0,3000)};}
 r.signatures[p.party]={...signature,at:time_(),by:s.name,op:assertId_(p.op)};r.revision++;r.updatedAt=time_();r.updatedBy=s.name;put_('Records',r);audit_(s,p.image?'Signature '+p.party:'Absence de signature '+p.party,r.id,{reason:p.reason||null,party:p.party,first:signature.first||null,last:signature.last||null,name:signature.name||null,collectedBy:s.name});return r;}
function finalize_(s,p){let r=writeRecord_(s,p);if(r.state==='final')return r;r=ready_(s,p);if(!r.signatures.loueur||!r.signatures.locataire)throw Error('Choisis signer ou pas de signature pour chaque partie');r.state='final';r.finalAt=time_();r.finalBy=s.name;r.lockedAt=r.lockedAt||r.finalAt;r.revision++;r.updatedAt=r.finalAt;put_('Records',r);audit_(s,'Clôture',r.id,{revision:r.revision});return r;}
function amendment_(s,p){admin_(s);const r=record_(s,p.record,false);if(r.archived)throw Error('DOSSIER_ARCHIVE');if(r.state!=='final')throw Error('Un avenant concerne un contrôle clôturé');assertId_(p.id);const old=get_('Amendments',p.id);if(old)return old;if(!String(p.reason||'').trim()||!Array.isArray(p.changes)||!p.changes.length)throw Error('Motif et modifications obligatoires');for(const c of p.changes){if(!Array.isArray(c.path)||!c.path.length||c.path.some(k=>['__proto__','prototype','constructor'].includes(k)))throw Error('Champ invalide');let actual=r.data;for(const k of c.path)actual=actual?.[k];if(!Model.same(actual,c.old))throw Error('Ancienne valeur incorrecte');if(typeof c.value!=='string'||c.value.length>10000)throw Error('Nouvelle valeur invalide');}
 const evidence=p.photos||[];for(const id of evidence){const ph=get_('Photos',id);if(!ph||ph.record!==r.id||!ph.amendment||ph.deleted)throw Error('Justificatif invalide');}
 const a={id:p.id,record:r.id,number:rows_('Amendments').filter(x=>x.record===r.id).length+1,at:time_(),by:s.name,reason:String(p.reason).slice(0,5000),changes:p.changes,photos:evidence,pdf:null};put_('Amendments',a);audit_(s,'Avenant administrateur',r.id,{amendment:a.id,reason:a.reason});return a;}

function deleteDraft_(s,p){assertId_(p.id);const r=get_('Records',p.id);
 if(r){editionAccess_(s,r.edition,true);if(r.deleted)return {id:r.id,deleted:true};writeRecord_(s,p);if(r.state!=='draft'||Object.keys(r.signatures||{}).length)throw Error('Seul un contrôle en cours non signé peut être supprimé');if(!Number.isSafeInteger(p.revision)||r.revision!==p.revision)throw Error('Le dossier a changé. Ouvre-le avant de réessayer.');r.deleted=true;r.updatedAt=time_();r.revision++;put_('Records',r);}
 else{if(p.edition!==active_())throw Error('Édition locale différente de l’édition active');editionAccess_(s,p.edition,true);}
 // Le marqueur persistant bloque aussi une création dont la réponse a été perdue.
 if(!get_('Operations','deleted:'+p.id)){put_('Operations',{id:'deleted:'+p.id,record:p.id,edition:r?r.edition:p.edition,at:time_(),by:s.name});audit_(s,'Suppression du brouillon',p.id,{});}return {id:p.id,deleted:true};}

const VEHICLE_EXISTS_='Ce véhicule possède déjà un contrôle. Demande à un référent de le débloquer pour commencer une nouvelle fiche.';
function assertVehicleAvailable_(s,p){
 editionAccess_(s,p.edition||active_(),false);
 const plate=Model.plate(p.plate);if(!/^[A-Z]{2}[0-9]{3}[A-Z]{2}$/.test(plate))throw Error('Immatriculation attendue : AA123BB');
 const records=rows_('Records').filter(r=>!r.deleted&&!r.archived&&r.edition===active_()&&r.data.vehicle.plate===plate);
 // A completed pickup is the immutable source of its one return, never a second pickup.
 const blocking=records.filter(r=>!(p.kind==='return'&&r.id===p.initialId&&r.kind==='pickup'&&r.state==='final'));
 if(blocking.length)throw Error(VEHICLE_EXISTS_);return {available:true,plate};
}
function activity_(s,p){const r=writeRecord_(s,p);if(r.state!=='draft')return presentRecord_(r);if(!['input','photo','view','damage','review'].includes(p.event))throw Error('Activité invalide');r.lastActivityAt=time_();put_('Records',r);return {id:r.id,lastActivityAt:r.lastActivityAt,businessStatus:businessStatus_(r)}}
function takeover_(s,p){admin_(s);assertId_(p.op);const r=record_(s,p.id,true);if(r.takeoverOp===p.op&&r.owner===actorKey_(s))return presentRecord_(r);if(r.state!=='draft'||Object.keys(r.signatures||{}).length)throw Error('Seul un contrôle non signé peut être repris');if(r.revision!==p.revision)throw Error('Le dossier a changé. Actualise la liste.');const previous=r.owner||r.createdBy;r.owner=actorKey_(s);r.lease=id_();r.takeoverOp=p.op;r.revision++;r.lastActivityAt=time_();r.updatedAt=r.lastActivityAt;r.updatedBy=s.name;put_('Records',r);audit_(s,'Reprise du contrôle',r.id,{previous,revision:r.revision});return presentRecord_(r)}
function archiveControl_(s,p){admin_(s);assertId_(p.op);const existing=get_('Operations','archive:'+p.op);if(existing){if(existing.record!==p.id)throw Error('Opération incohérente');return existing;}const r=record_(s,p.id,true);if(r.revision!==p.revision)throw Error('Le dossier a changé. Actualise la liste.');if(businessStatus_(r)!=='Bloqué'||r.state!=='draft'||Object.keys(r.signatures||{}).length)throw Error('Seul un contrôle bloqué non signé peut être débloqué');const related=rows_('Records').filter(x=>!x.deleted&&!x.archived&&x.edition===r.edition&&x.data.vehicle.plate===r.data.vehicle.plate);const at=time_();for(const item of related){item.archived=true;item.archiveReference='X'+item.data.vehicle.plate+'-'+item.id;item.archivedAt=at;item.archivedBy=s.name;item.lease=id_();item.revision++;put_('Records',item);audit_(s,'Archivage et déblocage',item.id,{reference:item.archiveReference,operation:p.op});}const result={id:'archive:'+p.op,record:r.id,archived:true,at,records:related.map(x=>x.id)};put_('Operations',result);return result}
function deleteControl_(s,p){admin_(s);assertId_(p.op);const r=get_('Records',p.id);if(!r)throw Error('Dossier introuvable');editionAccess_(s,r.edition,true);if(r.deleted)return {id:r.id,deleted:true};if(r.archived)throw Error('Archive en lecture seule');if(r.revision!==p.revision)throw Error('Le dossier a changé. Actualise la liste.');const signed=r.state!=='draft'||Object.keys(r.signatures||{}).length>0;if(p.confirm!==true||signed&&p.confirmSigned!==true)throw Error('Confirmation de suppression requise');r.deleted=true;r.lease=id_();r.revision++;r.updatedAt=time_();r.deletedBy=s.name;put_('Records',r);put_('Operations',{id:'deleted:'+r.id,record:r.id,edition:r.edition,at:time_(),by:s.name});audit_(s,'Suppression du contrôle',r.id,{signed,operation:p.op});return {id:r.id,deleted:true}}
