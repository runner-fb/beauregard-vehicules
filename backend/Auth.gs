function hashCode_(code,role){return digest_(props_().getProperty('PEPPER')+'|'+role+'|'+code)}
function equal_(a,b){if(typeof a!=='string'||typeof b!=='string')return false;let n=a.length^b.length;for(let i=0;i<Math.max(a.length,b.length);i++)n|=(a.charCodeAt(i)||0)^(b.charCodeAt(i)||0);return n===0}
function login_(p){return lock_(()=>{const role=typeof p.code==='string'&&equal_(hashCode_(p.code,'admin'),props_().getProperty('CODE_admin'))?'admin':'controller';const cache=CacheService.getScriptCache();const key='login-limit:access';const state=JSON.parse(cache.get(key)||'{"count":0,"until":0}');if(state.until>Date.now())throw Error('Trop de tentatives. Réessaie dans 15 minutes.');
 if(typeof p.code!=='string'||p.code.length>256||!equal_(hashCode_(p.code,role),props_().getProperty('CODE_'+role))){state.count++;if(state.count>=12)state.until=Date.now()+900000;cache.put(key,JSON.stringify(state),900);throw Error('Code incorrect')}
 cache.remove(key);const token=id_()+id_();const s={id:digest_(token),name:'',role,expires:Date.now()+6*3600000,epoch:props_().getProperty('AUTH_EPOCH')||'1'};put_('Sessions',s);return {token,role,expires:s.expires,edition:active_()};})}
function session_(token,identity=true){if(typeof token!=='string'||token.length>150)throw Error('SESSION_EXPIRED');const s=get_('Sessions',digest_(token));if(!s||!['admin','controller'].includes(s.role)||s.expires<Date.now()||s.epoch!==(props_().getProperty('AUTH_EPOCH')||'1'))throw Error('SESSION_EXPIRED');if(identity&&!s.name)throw Error('Renseigne ton prénom et ton nom');return s}
function identity_(s,p){const first=String(p.first||'').trim(),last=String(p.last||'').trim();if(!first||!last||first.length>60||last.length>60)throw Error('Prénom et nom obligatoires');s.name=first+' '+last;s.first=first;s.last=last;put_('Sessions',s);return {name:s.name,first:s.first,last:s.last,role:s.role,expires:s.expires,edition:active_()}}
function configureCodes(){const ui=SpreadsheetApp.getUi();const codes={};for(const role of ['controller','admin']){const r=ui.prompt(role==='admin'?'Second code administrateur':'Code commun contrôleur','Saisis au moins 12 caractères. Le code ne sera pas conservé en clair.',ui.ButtonSet.OK_CANCEL);if(r.getSelectedButton()!==ui.Button.OK)return;const code=r.getResponseText();if(code.length<12||code.length>256)throw Error('Entre 12 et 256 caractères');codes[role]=code;}if(codes.controller===codes.admin)throw Error('Les deux codes doivent être différents');lock_(()=>{props_().setProperties({CODE_controller:hashCode_(codes.controller,'controller'),CODE_admin:hashCode_(codes.admin,'admin'),AUTH_EPOCH:id_()})});ui.alert('Codes modifiés. Les anciennes sessions sont révoquées.')}
