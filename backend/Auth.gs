function hashCode_(code,role){return digest_(props_().getProperty('PEPPER')+'|'+role+'|'+code)}
function equal_(a,b){if(typeof a!=='string'||typeof b!=='string')return false;let n=a.length^b.length;for(let i=0;i<Math.max(a.length,b.length);i++)n|=(a.charCodeAt(i)||0)^(b.charCodeAt(i)||0);return n===0}
function login_(p){return lock_(()=>{const role=typeof p.code==='string'&&equal_(hashCode_(p.code,'admin'),props_().getProperty('CODE_admin'))?'admin':'controller';const cache=CacheService.getScriptCache();const key='login-limit:access';const state=JSON.parse(cache.get(key)||'{"count":0,"until":0}');if(state.until>Date.now())throw Error('Trop de tentatives. Réessaie dans 15 minutes.');
 if(typeof p.code!=='string'||p.code.length>256||!equal_(hashCode_(p.code,role),props_().getProperty('CODE_'+role))){state.count++;if(state.count>=12)state.until=Date.now()+900000;cache.put(key,JSON.stringify(state),900);throw Error('Code incorrect')}
 cache.remove(key);const token=id_()+id_();const s={id:digest_(token),name:'',role,expires:Date.now()+6*3600000,epoch:props_().getProperty('AUTH_EPOCH')||'1'};put_('Sessions',s);return {token,role,expires:s.expires,edition:active_()};})}
function session_(token,identity=true){if(typeof token!=='string'||token.length>150)throw Error('SESSION_EXPIRED');const s=get_('Sessions',digest_(token));if(!s||!['admin','controller'].includes(s.role)||s.expires<Date.now()||s.epoch!==(props_().getProperty('AUTH_EPOCH')||'1'))throw Error('SESSION_EXPIRED');if(s.name&&s.identityVersion!==2)throw Error('SESSION_EXPIRED');if(identity&&!s.name)throw Error('Renseigne ton prénom et ton nom');if(identity&&s.actorId?.startsWith('runner:')&&!integrationPeople_(s.role).some(p=>'runner:'+p.id===s.actorId))throw Error('SESSION_EXPIRED');return s}
function identity_(s,p){let person;if(p.personId){person=integrationPeople_(s.role).find(x=>x.id===p.personId);if(!person)throw Error('Cette personne n’est plus autorisée');if(p.handoff){const linked=runnerHandoff_(p.handoff,s,true);if(linked!==person.id)throw Error('Identité Runner différente');}s.actorId='runner:'+person.id;}else{if(s.role==='admin')throw Error('Choisis un référent autorisé');const first=String(p.first||'').trim(),last=String(p.last||'').trim();if(!first||!last||first.length>60||last.length>60)throw Error('Prénom et nom obligatoires');person={first,last};s.actorId='manual:'+digest_((first+' '+last).normalize('NFKC').toLocaleLowerCase('fr'));}s.name=person.first+' '+person.last;s.first=person.first;s.last=person.last;s.identityVersion=2;put_('Sessions',s);return {name:s.name,first:s.first,last:s.last,actorId:s.actorId,role:s.role,expires:s.expires,edition:active_()}}
function runnerDb_(){return SpreadsheetApp.openById(props_().getProperty('RUNNER_DATABASE_ID')||'1lDjo1yA1WNsuih89lQSdTHYCkN193mwTRBdppnZmAvs')}
function integrationPeople_(role){const sheet=runnerDb_().getSheetByName(role==='admin'?'BG_REFERENTS_VEHICULES':'BG_CONTROLEURS_VEHICULES');if(!sheet)throw Error('La liaison Runner doit être initialisée');return sheet.getDataRange().getValues().slice(1).filter(row=>row[0]&&row[1]&&row[2]).map(row=>({id:String(row[0]),first:String(row[1]),last:String(row[2]),name:row[1]+' '+row[2]})).sort((a,b)=>a.name.localeCompare(b.name,'fr'))}
function runnerHandoff_(ticket,s,consume){if(typeof ticket!=='string'||!/^[a-zA-Z0-9-]{60,100}$/.test(ticket))throw Error('Liaison Runner invalide');const sheet=runnerDb_().getSheetByName('BG_VEHICULES_LIAISONS');if(!sheet)throw Error('Liaison Runner indisponible');const rows=sheet.getDataRange().getValues(),i=rows.findIndex((row,n)=>n>0&&row[0]===digest_(ticket));if(i<0)throw Error('Liaison Runner inconnue');const value=JSON.parse(rows[i][1]);if(value.expires<Date.now()||value.usedBy&&value.usedBy!==s.id)throw Error('Liaison Runner expirée. Choisis ton nom.');if(!integrationPeople_('controller').some(p=>p.id===value.personId))throw Error('Autorisation Runner retirée');if(consume){value.usedBy=s.id;sheet.getRange(i+1,2).setValue(JSON.stringify(value));}return value.personId}
function identities_(s,p){const people=integrationPeople_(s.role);let selected=null,warning=null;if(p.handoff&&s.role==='controller'){try{selected=runnerHandoff_(p.handoff,s,false);}catch(e){warning=e.message;}}return {people,selected,warning}}

function configureCodes(){const ui=SpreadsheetApp.getUi();const codes={};for(const role of ['controller','admin']){const r=ui.prompt(role==='admin'?'Second code administrateur':'Code commun contrôleur','Saisis au moins 12 caractères. Le code ne sera pas conservé en clair.',ui.ButtonSet.OK_CANCEL);if(r.getSelectedButton()!==ui.Button.OK)return;const code=r.getResponseText();if(code.length<12||code.length>256)throw Error('Entre 12 et 256 caractères');codes[role]=code;}if(codes.controller===codes.admin)throw Error('Les deux codes doivent être différents');lock_(()=>{props_().setProperties({CODE_controller:hashCode_(codes.controller,'controller'),CODE_admin:hashCode_(codes.admin,'admin'),AUTH_EPOCH:id_()})});ui.alert('Codes modifiés. Les anciennes sessions sont révoquées.')}
