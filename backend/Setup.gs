function setupVehicles(){const ui=SpreadsheetApp.getUi();const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw Error('Ouvre un Google Sheets neuf puis Extensions > Apps Script');const p=props_();if(p.getProperty('DATABASE_ID')&&p.getProperty('DATABASE_ID')!==ss.getId())throw Error('Ce projet est déjà lié à une autre base');p.setProperty('DATABASE_ID',ss.getId());for(const n of TABLES_)if(!ss.getSheetByName(n)){const sh=ss.insertSheet(n);sh.getRange(1,1,1,11).setValues([['id',...Array.from({length:10},(_,i)=>'json_'+i)]]);sh.setFrozenRows(1);}if(!p.getProperty('PEPPER'))p.setProperty('PEPPER',id_()+id_());if(!p.getProperty('ACTIVE_EDITION'))p.setProperty('ACTIVE_EDITION','2027');if(!p.getProperty('DATA_FOLDER_ID')){const parent=DriveApp.getFolderById('1-Hb8eAkTPF3IQJNpNH0n54e54gxHUmAC');const root=folder_(parent,'Beauregard — Véhicules');p.setProperty('DATA_FOLDER_ID',root.getId());p.setProperty('ASSETS_FOLDER_ID',folder_(root,'Illustrations système').getId());}if(!get_('Editions','2027'))put_('Editions',{id:'2027',name:'Beauregard 2027'});p.setProperty('FRONTEND_ORIGIN','https://runner-fb.github.io');ui.alert('Base initialisée. Configure les codes puis copie les 15 illustrations PNG dans « Illustrations système ». Aucune édition antérieure n’a été archivée.');}
function verifyInstallation(){const p=props_();const missing=['DATABASE_ID','DATA_FOLDER_ID','ASSETS_FOLDER_ID','CODE_admin','CODE_controller','PEPPER','FRONTEND_ORIGIN'].filter(k=>!p.getProperty(k));for(const type of ['voiture','minibus','utilitaire'])for(const view of Model.views)if(p.getProperty('ASSETS_FOLDER_ID')&&!DriveApp.getFolderById(p.getProperty('ASSETS_FOLDER_ID')).getFilesByName(type+'-'+view+'.png').hasNext())missing.push(type+'-'+view+'.png');SpreadsheetApp.getUi().alert(missing.length?'Manque : '+missing.join(', '):'Configuration présente. Les essais fonctionnels restent nécessaires.');}
function onOpen(){SpreadsheetApp.getUi().createMenu('Beauregard Véhicules').addItem('Installer / vérifier la base','setupVehicles').addItem('Configurer les deux codes','configureCodes').addItem('Vérifier la configuration','verifyInstallation').addToUi()}
